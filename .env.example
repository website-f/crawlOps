# ---- copy to .env and fill in ----

# Core
POSTGRES_PASSWORD=crawlops_dev
MEILI_MASTER_KEY=crawlops_meili_dev_key

# Admin login (seeded on first boot; change before exposing)
ADMIN_USER=admin
ADMIN_PASSWORD=crawlops-change-me
MINIO_ROOT_USER=crawlops
MINIO_ROOT_PASSWORD=crawlops_dev_secret
LITELLM_MASTER_KEY=sk-crawlops-master-dev

# Internal URLs (defaults match docker-compose; do not change unless you know why)
DATABASE_URL=postgresql+psycopg://crawlops:crawlops_dev@postgres:5432/crawlops
REDIS_URL=redis://redis:6379/0
MEILI_URL=http://meilisearch:7700
MINIO_URL=http://minio:9000
LITELLM_URL=http://litellm:4000
CAMOFOX_URL=http://camofox:9377
RSSHUB_URL=http://rsshub:1200

# Ports exposed on the host
# 127.0.0.1 keeps every port behind the reverse proxy; 0.0.0.0 exposes them publicly
BIND_ADDR=127.0.0.1
FRONTEND_PORT=8400
API_PORT=8401
LITELLM_PORT=8402
MEILI_PORT=8403
MINIO_CONSOLE_PORT=8404

# Performance
API_WORKERS=2
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE=2GB

# ---- AI providers (leave blank to disable a provider; rotation skips blanks) ----
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ---- Tier-1 platform credentials (optional; connectors without them stay dormant) ----
THREADS_ACCESS_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Tier-3 stealth ----
CAMOFOX_ACCESS_KEY=
ALLOW_DIRECT_STEALTH=0
PROXY_STRATEGY=
PROXY_BACKCONNECT_HOST=
PROXY_BACKCONNECT_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# ---- Pipeline tuning ----
JUDGE_THRESHOLD_DEFAULT=55
CLUSTER_SIM_NEWS=0.82
CLUSTER_SIM_SOCIAL=0.78
ENRICH_CATCHUP_MINUTES=15
SECRET_KEY=change-me-32+chars-random-secret
